# =============================================================================
# BBX PAW OpenClaw Integration — Environment Variables
# =============================================================================
# Copy to .env and fill in real values. Never commit .env — it is gitignored.
# See docs/SETUP.md for step-by-step instructions and docs/ARCHITECTURE.md for
# how each variable is used.
# =============================================================================

# -----------------------------------------------------------------------------
# OpenClaw Gateway
# -----------------------------------------------------------------------------
# Port the Gateway listens on (WS + HTTP multiplexed on one port).
OPENCLAW_PORT=18789
# Bind mode: "loopback" (127.0.0.1 only, default upstream) or "lan" (0.0.0.0).
# Must be "lan" behind Coolify/Docker bridge networking so the reverse proxy
# can reach the container. Requires OPENCLAW_GATEWAY_TOKEN to be set.
OPENCLAW_GATEWAY_BIND=lan
# Bearer token required by every Gateway client (Control UI, CLI, Trigger.dev
# job, BBX Chat). Generate with: openssl rand -hex 32
# NEVER paste an example/placeholder value here — OpenClaw refuses to start
# if this matches a documented example token verbatim.
OPENCLAW_GATEWAY_TOKEN=

# Host paths (bind-mounted into the container, see docker-compose.yml).
OPENCLAW_CONFIG_DIR=./.openclaw
OPENCLAW_WORKSPACE_DIR=./workspace
OPENCLAW_AUTH_PROFILE_SECRET_DIR=./.openclaw-auth-profile-secrets
OPENCLAW_TZ=UTC

# -----------------------------------------------------------------------------
# AWS Bedrock (model inference + Titan embeddings for agent memory)
# -----------------------------------------------------------------------------
# Bedrock auth uses the AWS SDK default credential chain (not an API key).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: only needed for temporary/STS credentials.
# AWS_SESSION_TOKEN=

# -----------------------------------------------------------------------------
# 4-Tier Model Strategy (see config/models.yaml for full definitions)
# -----------------------------------------------------------------------------
# Tier 1 — cheap tasks (Bedrock).
MODEL_CHEAP=us.amazon.nova-pro-v1:0
# Tier 2 — default worker. NOT a Bedrock model (Bedrock has no OpenAI/GPT
# models) — must be served by an OpenAI-compatible endpoint. Leave the two
# vars below empty to fall back to a Bedrock model instead; see
# config/models.yaml for the full explanation.
MODEL_DEFAULT=gpt-5.6-luna
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# Tier 3 — coding / analysis (Bedrock). Replace with the exact inference
# profile id from `openclaw models list` for your account/region.
MODEL_CODING=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Tier 4 — critical tasks (Bedrock). Placeholder until Claude Sonnet 5 ships
# on Bedrock — replace with the real id once available.
MODEL_CRITICAL=us.anthropic.claude-opus-4-6-v1

# -----------------------------------------------------------------------------
# Trigger.dev (self-hosted at https://server.pddt.in)
# -----------------------------------------------------------------------------
TRIGGER_API_URL=https://server.pddt.in
# Secret key from the Trigger.dev dashboard (server-side triggering).
TRIGGER_SECRET_KEY=
# Legacy/back-compat alias some BBX Chat code may still reference.
TRIGGER_API_KEY=
TRIGGER_PROJECT_REF=

# -----------------------------------------------------------------------------
# MongoDB (shared with BBX Chat)
# -----------------------------------------------------------------------------
# Used ONLY by workflows/trigger-jobs/openclaw-task.js to persist job
# status/results alongside BBX Chat's own collections. OpenClaw's own
# Gateway state is always local SQLite (see docs/ARCHITECTURE.md) and does
# not read this variable.
MONGO_URI=
MONGO_DB_NAME=bbx_chat
MONGO_PAW_JOBS_COLLECTION=paw_jobs

# -----------------------------------------------------------------------------
# Workspace
# -----------------------------------------------------------------------------
WORKSPACE_PATH=/workspace

# -----------------------------------------------------------------------------
# BBX Chat callback (job completion notifications)
# -----------------------------------------------------------------------------
BBX_CHAT_BASE_URL=https://chat.bharatbaas.com
BBX_CHAT_WEBHOOK_SECRET=
